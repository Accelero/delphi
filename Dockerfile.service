# syntax=docker/dockerfile:1.7

FROM rust:1-bookworm AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY Cargo.toml ./
COPY Cargo.lock ./
COPY crates ./crates
COPY services ./services
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo chef cook --release --workspace --recipe-path recipe.json
COPY Cargo.toml ./
COPY Cargo.lock ./
COPY crates ./crates
COPY services ./services
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --release --workspace --bins \
    && cp /app/target/release/api-service /usr/local/bin/api-service \
    && cp /app/target/release/realtime-service /usr/local/bin/realtime-service \
    && cp /app/target/release/chat-worker /usr/local/bin/chat-worker

FROM debian:bookworm-slim
ENV RUST_LOG=info
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/api-service /usr/local/bin/api-service
COPY --from=build /usr/local/bin/realtime-service /usr/local/bin/realtime-service
COPY --from=build /usr/local/bin/chat-worker /usr/local/bin/chat-worker
