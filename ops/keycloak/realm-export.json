{
  "realm": "delphi",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "member", "description": "Standard tenant member" },
      { "name": "owner", "description": "Tenant owner" },
      { "name": "ingester", "description": "Permitted to ingest documents" }
    ]
  },
  "clients": [
    {
      "clientId": "delphi",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/oauth2/callback", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1800",
        "post.logout.redirect.uris": "http://localhost:8080/"
      },
      "protocolMappers": [
        {
          "name": "tenant_id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@example.com",
      "firstName": "User",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": ["member", "owner"],
      "attributes": {
        "tenant_id": ["tenant-a"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ]
    },
    {
      "username": "test",
      "email": "test@example.com",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": ["member"],
      "attributes": {
        "tenant_id": ["tenant-a"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ]
    }
  ]
}
