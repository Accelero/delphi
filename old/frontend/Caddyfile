# Caddyfile for the Delphi SPA in Tier-2 / prod.
#
# TLS, routing, auth, and access policy all live at Traefik in front
# of this container. Caddy's job here is narrow: serve the built
# `dist/`, do SPA fallback for client-side routes (TanStack Router),
# and emit sensible cache + compression headers. No HTTPS, no
# auto-cert — Traefik handles all of that upstream.

:80 {
	root * /usr/share/caddy
	encode zstd gzip

	# Long-cache hashed assets — Vite emits `assets/<name>-<hash>.{js,css,…}`
	# with content hashes that change on every build, so the 1-year
	# `immutable` cache is safe.
	@hashed path_regexp ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|svg|png|jpe?g|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Never cache the entry document — it points at whichever hashed
	# asset is current and must always be revalidated.
	header /index.html Cache-Control "no-cache"

	# Standard static-file serving for everything that exists on disk;
	# anything that doesn't exist falls back to index.html so
	# client-side routes (e.g. /discovery, /chat/<id>) work on direct
	# load and refresh.
	try_files {path} /index.html
	file_server
}
