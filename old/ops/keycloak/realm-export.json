{
  "realm": "delphi",
  "enabled": true,
  "displayName": "Delphi (dev)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      { "name": "member", "description": "Standard tenant member" },
      {
        "name": "owner",
        "description": "Tenant owner — admin within tenant; composite of ingester so owners can ingest without a separate assignment",
        "composite": true,
        "composites": { "realm": ["ingester"] }
      },
      { "name": "ingester", "description": "Permitted to call ingestion endpoints" }
    ]
  },

  "groups": [
    { "name": "tenant-a" },
    { "name": "tenant-b" }
  ],

  "users": [
    {
      "username": "alice",
      "email": "alice@delphi.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "dev-password", "temporary": false }
      ],
      "realmRoles": ["member", "owner"],
      "groups": ["tenant-a"],
      "attributes": {
        "tenant_id": ["tenant-a"]
      }
    },
    {
      "username": "bob",
      "email": "bob@delphi.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "dev-password", "temporary": false }
      ],
      "realmRoles": ["member"],
      "groups": ["tenant-b"],
      "attributes": {
        "tenant_id": ["tenant-b"]
      }
    }
  ],

  "clients": [
    {
      "clientId": "delphi-dev",
      "name": "Delphi dev client",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/oauth2/callback",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1800",
        "post.logout.redirect.uris": "http://localhost/"
      },
      "protocolMappers": [
        {
          "name": "tenant_id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "surreal-ac-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "ac",
            "claim.value": "app_session",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "surreal-ns-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "ns",
            "claim.value": "delphi",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "surreal-db-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "db",
            "claim.value": "main",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
