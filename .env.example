# Copy to .env if you need overrides. Compose uses these defaults inline;
# this file documents what the backend reads.

# storage
STORAGE_BACKEND=surreal
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=delphi
SURREAL_DB=main

# backend HTTP server
BIND_ADDR=0.0.0.0:8081
# Optional path to built frontend (Vite `dist/`); unset in dev — Vite serves the SPA
# STATIC_DIR=/app/static

# logging
RUST_LOG=info,delphi=debug

# ---------- Auth ----------
# `dev`  — auto-injects a fixed identity (requires the backend to be built
#          with the `dev-auth` cargo feature; compose passes this by default).
# `oidc` — verifies tokens against OIDC_ISSUER, runs the redirect flow.
AUTH_MODE=dev
# Production marker. With AUTH_MODE=dev + RUST_ENV=production the backend
# refuses to start (runtime guard).
RUST_ENV=development
# Cargo features baked into the docker image. Dev: `dev-auth`. Prod: empty.
BACKEND_FEATURES=dev-auth

# Session cookie. 64+ bytes of base64. Generate: openssl rand -base64 64
# Required in OIDC mode. In dev mode a per-process random key is generated.
SESSION_KEY=
# Auto-on when RUST_ENV=production.
SECURE_COOKIES=false

# ---------- OIDC (used when AUTH_MODE=oidc) ----------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Public base URL the IdP redirects back to. Register `<base>/*` as an
# allowed redirect URI in the IdP's app config.
OIDC_APPLICATION_BASE_URL=http://localhost:8081
OIDC_SCOPES=openid profile email
# Name of the JWT claim carrying the tenant identifier.
OIDC_TENANT_CLAIM=org_id
# Fallback tenant slug when the tenant claim is missing/unknown.
OIDC_DEFAULT_TENANT_SLUG=default
# Where to send the browser after a successful login.
OIDC_POST_LOGIN_REDIRECT=/

# ---------- Dev mode (honored only when built with dev-auth feature) ----------
DEV_TENANT_SLUG=dev
DEV_USER_EMAIL=dev@delphi.local
DEV_USER_NAME=Dev User

# ---------- LLM provider — used by /api/chat ----------
# Supported: anthropic, openai, minimax
LLM_PROVIDER=anthropic
# Defaults: anthropic→claude-sonnet-4-5, openai→gpt-4o-mini, minimax→MiniMax-M2.7
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
# Optional: override the MiniMax base URL (default: https://api.minimax.io/v1).
# Use https://api.minimaxi.com/v1 for the China region.
# MINIMAX_BASE_URL=https://api.minimax.io/v1
