# Copy to .env if you need overrides. Compose uses these defaults inline;
# this file documents what the backend reads.

# storage
STORAGE_BACKEND=surreal
DELPHI_DB_URL=ws://surrealdb:8000/rpc
# Service-account credentials for the backend's privileged DB connection
# (boot, admin, scheduler). The runtime production guard refuses 'root'
# / unset values when DELPHI_ENV=production. Provision a dedicated DB user
# with the EDITOR role for production.
DELPHI_DB_USER=root
DELPHI_DB_PASSWORD=root
DELPHI_DB_NAMESPACE=delphi
DELPHI_DB_NAME=main

# Per-request SurrealDB authentication. The backend forwards the IdP JWT
# unchanged to `db.authenticate(jwt)`; SurrealDB validates against the
# `app_session` access method we register at startup. Two modes:
#   `jwks`  — production (real IdP). Requires DELPHI_DB_JWT_JWKS_URL.
#   `hs512` — tier-1 dev and tests. Requires DELPHI_DB_JWT_SECRET.
DELPHI_DB_JWT_MODE=hs512
DELPHI_DB_JWT_SECRET=tier1-dev-jwt-secret-not-for-production
# DELPHI_DB_JWT_JWKS_URL=http://keycloak:8080/realms/delphi/protocol/openid-connect/certs
# DELPHI_DB_JWT_ISSUER=  # optional: AUTHENTICATE clause throws on mismatch
# DELPHI_DB_JWT_AUDIENCE=  # optional: AUTHENTICATE clause throws on mismatch
# DELPHI_DB_JWT_SESSION_SECS=1800  # optional: DB session lifetime per authenticate

# Physical SurrealDB connections kept in the per-request pool. Each
# connection serves one in-flight authenticated request at a time; on
# scope exit the request guard logs out (db.invalidate) and returns
# the connection. Default 8; tune with concurrency profile in mind.
# DELPHI_DB_POOL_SIZE=8

# Single-tenant v1 scheduler ingest: which tenant the bundled adapters
# (arXiv etc.) write into. Resolves to RecordId at startup.
DELPHI_SOURCES_DEFAULT_TENANT=default

# backend HTTP server
DELPHI_SERVER_BIND_ADDR=0.0.0.0:8081
# Optional path to built frontend (Vite `dist/`); unset in dev — Vite serves the SPA
# STATIC_DIR=/app/static

# logging
RUST_LOG=info,delphi=debug

# ---------- Auth ----------
# Two modes:
#   `header` — production. Trust an upstream BFF (Traefik + oauth2-proxy)
#              to set `X-Auth-*` headers on every request. The backend
#              does no token / cookie work.
#   `dev`    — local dev. A small middleware (compiled in only when the
#              backend is built with the `dev-auth` cargo feature) writes
#              the same `X-Auth-*` headers itself, so the production
#              identity middleware runs unchanged.
DELPHI_AUTH_MODE=dev
# Production marker. With DELPHI_AUTH_MODE=dev + DELPHI_ENV=production the backend
# refuses to start (runtime guard).
DELPHI_ENV=development
# Cargo features baked into the docker image. Dev: `dev-auth`. Prod: empty.
BACKEND_FEATURES=dev-auth

# Slug of the tenant requests fall back to when the proxy doesn't supply
# `X-Auth-Tenant-Id`. In dev this should match DELPHI_AUTH_DEV_TENANT.
DELPHI_AUTH_DEFAULT_TENANT=dev

# ---------- Dev mode (honored only when built with dev-auth feature) ----------
DELPHI_AUTH_DEV_TENANT=dev
DELPHI_AUTH_DEV_USER_EMAIL=dev@delphi.local
DELPHI_AUTH_DEV_USER_NAME=Dev User

# ---------- Source adapters (Discovery pillar) ----------
# Master switch for the in-process adapter scheduler. When unset/false the
# backend serves the HTTP ingestion endpoint but does not poll any sources.
DELPHI_SOURCES_ENABLED=false

# arXiv adapter — replaces the slice-1 Semantic Scholar adapter.
# Construction gated on ARXIV_QUERY: unset = adapter not registered.
# Query syntax: https://info.arxiv.org/help/api/user-manual.html#_query_interface
# Examples:
#   ARXIV_QUERY=cat:cs.CL
#   ARXIV_QUERY=cat:cs.CL OR cat:cs.LG OR cat:cs.AI
#   ARXIV_QUERY=ti:"flash attention"
# ARXIV_QUERY=cat:cs.CL OR cat:cs.LG OR cat:cs.AI
# ARXIV_POLL_INTERVAL_SECS=21600   # 6 h; arXiv asks for friendly cadence
# ARXIV_PAGE_SIZE=50               # papers per cycle
# arXiv asks API consumers to include a contact email in the User-Agent
# so they can reach out before rate-limiting. Optional but reduces 429s.
# ARXIV_CONTACT_EMAIL=you@example.com
# Resource caps on the per-paper PDF pipeline (defence against malformed
# or oversized PDFs; scheduler keeps running even if one paper is
# pathological). Whichever limit trips first wins.
# ARXIV_MAX_PDF_BYTES=52428800     # 50 MB — streamed download aborts past this
# ARXIV_PDFTOTEXT_TIMEOUT_SECS=30  # wall-clock cap per pdftotext invocation
# ARXIV_MAX_EXTRACTED_TEXT_BYTES=4194304   # 4 MB — cap on body text from one PDF
# Whole-request and connect-handshake timeouts on every reqwest call
# (search + PDF fetch). Closes the slow-server / stalled-stream hole the
# size caps alone don't cover.
# ARXIV_HTTP_TIMEOUT_SECS=60
# ARXIV_HTTP_CONNECT_TIMEOUT_SECS=10

# ---------- Object storage (PDFs and other original artefacts) ----------
# S3-compatible only (MinIO in dev; any S3 provider in prod). The LocalFs
# backend has been removed. The bucket in the URL is informational; the
# connection knobs come from INGEST_S3_* below.
#   s3://bucket/        — S3-compatible (the only supported scheme)
DELPHI_INGEST_OBJECT_STORE_URL=s3://delphi/
#
# System dependency: the backend shells out to `pdftotext` (poppler-utils)
# for arXiv PDF extraction. Install on the runtime image with:
#   Debian/Ubuntu:  apt install poppler-utils
#   Arch/CachyOS:   pacman -S poppler

# ---------- Service identity (adapter → ingestion API loopback) ----------
# The in-process source-adapter scheduler POSTs to its own
# /api/ingestion/documents endpoint authenticated as a service identity
# — same trust boundary as user requests, JWT validated by the same
# pipeline. DELPHI_AUTH_MODE=dev mints HS512 locally with DELPHI_DB_JWT_SECRET;
# DELPHI_AUTH_MODE=header does OAuth2 client_credentials against the IdP.
#
# Loopback URL the scheduler POSTs to. Defaults to
# http://127.0.0.1:<DELPHI_SERVER_BIND_ADDR port>. Override only if the scheduler
# moves out of process or you proxy via a different host.
# DELPHI_INGEST_API_URL=http://127.0.0.1:8081
#
# OAuth2 client_credentials config for the arxiv adapter's service
# identity (tier-2 / prod only — tier-1 mints HS512 locally with
# DELPHI_DB_JWT_SECRET above). Required when DELPHI_AUTH_MODE=header and
# DELPHI_SOURCES_ENABLED=true.
# ARXIV_OAUTH_TOKEN_URL=http://keycloak:8080/realms/delphi/protocol/openid-connect/token
# ARXIV_OAUTH_CLIENT_ID=delphi-arxiv-adapter
# ARXIV_OAUTH_CLIENT_SECRET=

# ---------- Ingestion v2 — direct-to-S3 multipart uploads ----------
#
# The four upload endpoints (`POST /api/ingestion/uploads`,
# `…/sign-part`, `…/complete`, `GET /uploads/:id`) mint presigned URLs
# the SPA uploads to directly; bytes never traverse the backend.
# All knobs default to safe values, so most deployments leave this
# block commented.
#
# S3 backend — required (no LocalFs fallback). MinIO in dev, any S3
# provider in prod. The backend uses TWO endpoints: an INTERNAL one for
# its own HEAD/GET/complete/abort calls, and a PUBLIC one embedded in the
# presigned upload/download URLs the browser hits directly. They differ
# when the browser and the backend reach the store via different hosts
# (e.g. the browser hits MinIO's published :9000 while the backend talks
# to minio:9000 over the docker network). The browser never goes through
# Traefik for object bytes — see docs/architecture/object-access.md.
# SigV4 signs the host + full path, so the public endpoint must be
# exactly what the browser hits.
#
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD seed the dev MinIO and double as
# the S3 credentials (see docker-compose*.yml).
# DELPHI_INGEST_S3_ENDPOINT_INTERNAL=http://minio:9000
# DELPHI_INGEST_S3_ENDPOINT_PUBLIC=http://localhost:9000      # both tiers: browser → MinIO directly
# DELPHI_INGEST_S3_REGION=us-east-1
# DELPHI_INGEST_S3_BUCKET=delphi
# DELPHI_INGEST_S3_ACCESS_KEY_ID=delphi
# DELPHI_INGEST_S3_SECRET_ACCESS_KEY=delphi-minio-dev-secret-please-change
# DELPHI_INGEST_S3_FORCE_PATH_STYLE=true   # true for MinIO / Hetzner / B2; false for AWS / R2.
#
# App-required descriptive fields after the prefill/autofill merge.
# Empty by default (autofill is a noop until the LLM extractor lands).
# Comma-separated: title,authors,summary,language.
# DELPHI_INGEST_REQUIRED_METADATA_FIELDS=
#
# Upload/download protocol tuning.
# INGEST_UPLOAD_PART_SIZE_BYTES=8388608        # 8 MiB. S3 min is 5 MiB (except the last part).
# INGEST_UPLOAD_PART_URL_TTL_SECS=900          # 15 min — per-part presigned PUT URL lifetime.
# INGEST_DOWNLOAD_URL_TTL_SECS=120             # 2 min — presigned GET (view-url) lifetime; short by design (confidentiality).
# INGEST_UPLOAD_SESSION_TTL_SECS=3600          # 1 h — sign-part rejects older sessions.
# DELPHI_INGEST_UPLOAD_MAX_FILE_SIZE_BYTES=209715200  # 200 MiB — layer-1 metadata cap.
# DELPHI_INGEST_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown
#
# Object-validator tuning. Runs at /complete against the committed
# object: HEAD for size+ETag, ranged GET for magic-byte sniff, then
# format-specific parse (PDF page count, text UTF-8 check).
# DELPHI_INGEST_VALIDATOR_SNIFF_WINDOW_BYTES=4096
# DELPHI_INGEST_VALIDATOR_PDF_MAX_INPUT_BYTES=52428800   # 50 MiB.
# DELPHI_INGEST_VALIDATOR_PDF_MAX_PAGES=2000
# DELPHI_INGEST_VALIDATOR_PDF_TIMEOUT_SECS=30
# DELPHI_INGEST_VALIDATOR_REJECT_POLYGLOTS=true
#
# Rejection log + cleaner cadence (latter wires in once the nightly
# cleaner lands — values documented here so the env stays stable).
# INGEST_REJECTION_TTL_SECS=3600
# INGEST_CLEANUP_MIN_AGE_HOURS=4
# INGEST_CLEANUP_CRON=0 3 * * *

# ---------- LLM provider — used by /api/chat ----------
# Supported: anthropic, openai, minimax, gemini (alias: google)
DELPHI_PROVIDER=anthropic
# Defaults: anthropic→claude-sonnet-4-5, openai→gpt-4o-mini,
#           minimax→MiniMax-M2.7, gemini→gemini-2.5-flash
DELPHI_PROVIDER_MODEL=claude-sonnet-4-5
DELPHI_PROVIDER_ANTHROPIC_API_KEY=
DELPHI_PROVIDER_OPENAI_API_KEY=
DELPHI_PROVIDER_MINIMAX_API_KEY=
# Google Gemini (Generative Language API): https://aistudio.google.com/apikey
DELPHI_PROVIDER_GOOGLE_API_KEY=
# Optional: override the MiniMax base URL (default: https://api.minimax.io/v1).
# Use https://api.minimaxi.com/v1 for the China region.
# DELPHI_PROVIDER_MINIMAX_BASE_URL=https://api.minimax.io/v1

# ---------- Title generation — first-turn chat titles ----------
# NOTE: deliberate exception to the no-hardcoded-defaults rule that governs
# DELPHI_PROVIDER above. The chat provider fails closed (a blank value aborts
# startup) because there is no universally-correct chat model. The title model
# is the inverse: there IS a correct default — the `title-llm` sidecar bundled
# in both compose stacks — so this block ships working defaults applied in the
# factory, and overriding them is the opt-in. See docs/architecture/title-llm.md.
#
# Leave these unset to use the sidecar. Set DELPHI_TITLE_ENABLED=false to skip
# the sidecar and reuse the chat model (e.g. a bare `cargo run` with no docker).
# DELPHI_TITLE_ENABLED=true
# DELPHI_TITLE_PROVIDER=openai
# DELPHI_TITLE_BASE_URL=http://title-llm:80/v1
# DELPHI_TITLE_MODEL=Qwen2.5-0.5B-Instruct
# DELPHI_TITLE_API_KEY=sk-noauth
